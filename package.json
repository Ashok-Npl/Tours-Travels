{
  "name": "tours-travels",
  "version": "1.0.0",
  "private": true,
  "description": "Veron Crest Tours and Travels website",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "node node_modules/@tailwindcss/cli/dist/index.mjs -i ./public/css/input.css -o ./public/css/tailwind.css",
    "watch:css": "node node_modules/@tailwindcss/cli/dist/index.mjs -i ./public/css/input.css -o ./public/css/tailwind.css --watch"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "nodemon": "^3.1.14"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
