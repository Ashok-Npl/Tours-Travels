<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Destinations | Veron Crest Tours and Travels</title>
  <meta name="description" content="Discover Nepal with local guides, then explore outbound holidays across Asia and beyond with Veron Crest Tours and Travels.">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/tailwind.css">
  <link rel="stylesheet" href="/css/pages/destinations.css">
</head>
<body class="destinations-page bg-sand-50 text-slate-800 antialiased">
  <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
  <%- include('partials/navbar', { activePage: activePage }) %>

  <main>
    <section class="destination-page-hero destination-reveal">
      <div class="page-shell destination-hero-grid">
        <div>
          <span class="eyebrow">Nepal inbound & outbound travel</span>
          <h1>Start in Nepal.<br>Go <em>anywhere.</em></h1>
          <p>Explore Nepal with thoughtful local support, or plan an outbound holiday shaped around your interests and budget.</p>
        </div>
        <div class="destination-hero-side">
          <figure class="destination-hero-image"><img src="/assets/images/destination.png" alt="Travelers exploring a mountain destination"></figure>
          <div class="destination-hero-note"><span>Nepal</span><small>local journeys<br>& outbound holidays</small></div>
        </div>
      </div>
    </section>

    <section class="destination-directory destination-reveal">
      <div class="page-shell">
        <div class="destination-toolbar">
          <div>
            <span class="eyebrow">The directory</span>
            <h2>Where will you go next?</h2>
          </div>
          <div class="destination-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input id="destination-page-search" type="search" placeholder="Search a place or region" aria-label="Search destinations">
          </div>
        </div>
        <div class="destination-filters" role="group" aria-label="Filter destinations">
          <button class="dest-filter-btn active px-4 py-2 rounded-full text-xs font-bold bg-primary-500 text-white transition" data-filter="All">All places</button>
          <button class="dest-filter-btn px-4 py-2 rounded-full text-xs font-bold bg-slate-100 text-slate-600 transition" data-filter="Nepal">Nepal</button>
          <button class="dest-filter-btn px-4 py-2 rounded-full text-xs font-bold bg-slate-100 text-slate-600 transition" data-filter="Europe">Europe</button>
          <button class="dest-filter-btn px-4 py-2 rounded-full text-xs font-bold bg-slate-100 text-slate-600 transition" data-filter="Asia">Asia</button>
          <button class="dest-filter-btn px-4 py-2 rounded-full text-xs font-bold bg-slate-100 text-slate-600 transition" data-filter="Africa">Africa</button>
          <button class="dest-filter-btn px-4 py-2 rounded-full text-xs font-bold bg-slate-100 text-slate-600 transition" data-filter="Americas">Americas</button>
          <button class="dest-filter-btn px-4 py-2 rounded-full text-xs font-bold bg-slate-100 text-slate-600 transition" data-filter="Arctic">Arctic</button>
        </div>
        <div id="destinations-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 destination-directory-grid destination-reveal"></div>
      </div>
    </section>

    <section class="destination-cta destination-reveal">
      <div class="page-shell destination-cta-inner">
        <div><span class="eyebrow">Can’t choose?</span><h2>Tell us what you’re looking for.</h2><p>Our destination designers will match you with the right place, pace and point of view.</p></div>
        <a href="/contact" class="page-button">Speak to a designer <i class="fa-solid fa-arrow-right"></i></a>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <div id="generic-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/40 backdrop-blur-sm"><div class="bg-white rounded-2xl max-w-3xl w-full max-h-[90vh] overflow-y-auto p-5 sm:p-8 relative shadow-2xl"><button id="modal-close-btn" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center"><i class="fa-solid fa-xmark"></i></button><div id="modal-dynamic-content"></div></div></div>
  <div id="toast-container" class="fixed bottom-6 left-6 z-50 flex flex-col gap-2.5 pointer-events-none"></div>
  <script>
    (function () {
      var items = document.querySelectorAll('.destination-reveal');
      if (!('IntersectionObserver' in window)) {
        items.forEach(function (item) { item.classList.add('is-visible'); });
        return;
      }
      var observer = new IntersectionObserver(function (entries, instance) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            instance.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      items.forEach(function (item) { observer.observe(item); });
    })();
  </script>
  <script src="/js/data.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
  <script src="/js/client-app.js"></script>
</body>
</html>




