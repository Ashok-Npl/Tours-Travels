<!-- ═══════════════════════ GALLERY MAIN ═══════════════════════ -->
<section class="gallery-main-section py-16 sm:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4">

    <!-- Toolbar: title + search -->
