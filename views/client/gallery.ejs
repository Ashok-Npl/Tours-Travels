      <div>
        <span class="inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-widest text-primary-500 mb-1"><span class="w-2 h-2 rounded-full bg-primary-400 animate-pulse"></span>Browse Collection</span>
