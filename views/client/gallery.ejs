      </div>
      <div class="gallery-search-box">
        <i class="fa-solid fa-magnifying-glass text-slate-400 text-sm"></i>
        <input type="text" id="gallery-search" placeholder="Search destinations…" autocomplete="off">
      </div>
    </div>

    <!-- Filter tabs -->
    <div class="gallery-filter-row">
      <button class="gallery-filter-btn is-active" data-cat="All"><i class="fa-solid fa-globe mr-1.5"></i>All</button>
      <button class="gallery-filter-btn" data-cat="Europe"><i class="fa-solid fa-landmark mr-1.5"></i>Europe</button>
      <button class="gallery-filter-btn" data-cat="Asia"><i class="fa-solid fa-torii-gate mr-1.5"></i>Asia</button>
      <button class="gallery-filter-btn" data-cat="Africa"><i class="fa-solid fa-paw mr-1.5"></i>Africa</button>
      <button class="gallery-filter-btn" data-cat="Americas"><i class="fa-solid fa-mountain mr-1.5"></i>Americas</button>
      <button class="gallery-filter-btn" data-cat="Arctic"><i class="fa-solid fa-snowflake mr-1.5"></i>Arctic</button>
      <button class="gallery-filter-btn" data-cat="Tropical"><i class="fa-solid fa-umbrella-beach mr-1.5"></i>Tropical</button>
      <button class="gallery-filter-btn" data-cat="Adventure"><i class="fa-solid fa-person-hiking mr-1.5"></i>Adventure</button>
    </div>

    <!-- Gallery Grid -->
    <div id="gallery-grid" class="gallery-masonry-grid">
      <!-- Cards injected by JS -->
    </div>

    <!-- Empty state -->
    <div id="gallery-empty" class="gallery-empty-state hidden">
      <i class="fa-solid fa-camera-slash"></i>
      <h3>No photos found</h3>
      <p>Try a different category or search term</p>
      <button onclick="document.getElementById('gallery-search').value=''; filterGallery('All')" class="mt-4 px-6 py-2.5 bg-primary-500 text-white text-sm font-bold rounded-xl hover:bg-primary-600 transition">Reset Filters</button>
    </div>

    <!-- Load More -->
    <div class="gallery-load-more-wrap" id="load-more-wrap">
      <button id="load-more-btn" class="gallery-load-more-btn">
        <i class="fa-solid fa-plus mr-2"></i>Load More Photos
        <span id="load-more-count" class="gallery-load-more-count">12 remaining</span>
      </button>
    </div>
  </div>
</section>

