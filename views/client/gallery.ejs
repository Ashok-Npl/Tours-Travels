<script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
<script src="/js/mobile-menu.js"></script>
<script>
// ── Gallery Data ───────────────────────────────────────────────
const galleryItems = [
  { id:1,  title:'Aegean Caldera Sunrise',      location:'Santorini, Greece',      cat:'Europe',    img:'https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?auto=format&fit=crop&w=1200&q=85', size:'tall' },
  { id:2,  title:'Great Migration River Cross',  location:'Serengeti, Tanzania',    cat:'Africa',    img:'https://images.unsplash.com/photo-1516426122078-c23e76319801?auto=format&fit=crop&w=1200&q=85', size:'wide' },
  { id:3,  title:'Emerald Rice Terraces',        location:'Ubud, Bali',             cat:'Tropical',  img:'https://images.unsplash.com/photo-1537996194471-e657df975ab4?auto=format&fit=crop&w=1200&q=85', size:'normal' },
  { id:4,  title:'Aurora Borealis Dance',        location:'Tromsø, Norway',         cat:'Arctic',    img:'https://images.unsplash.com/photo-1517411032315-54ef2cb783bb?auto=format&fit=crop&w=1200&q=85', size:'tall' },
  { id:5,  title:'Kyoto Autumn Temple',          location:'Kyoto, Japan',           cat:'Asia',      img:'https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?auto=format&fit=crop&w=1200&q=85', size:'normal' },
  { id:6,  title:'Maldives Crystal Lagoon',      location:'North Malé Atoll',       cat:'Tropical',  img:'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=85', size:'wide' },
  { id:7,  title:'Amalfi Cliffside Villages',   location:'Amalfi Coast, Italy',    cat:'Europe',    img:'https://images.unsplash.com/photo-1533105079780-92b9be482077?auto=format&fit=crop&w=1200&q=85', size:'normal' },
  { id:8,  title:'Torres del Paine Spires',      location:'Patagonia, Chile',       cat:'Adventure', img:'https://images.unsplash.com/photo-1527004013197-933c4bb611b3?auto=format&fit=crop&w=1200&q=85', size:'tall' },
  { id:9,  title:'Matterhorn Majesty',           location:'Zermatt, Switzerland',   cat:'Europe',    img:'https://images.unsplash.com/photo-1527668752968-14dc70a27c95?auto=format&fit=crop&w=1200&q=85', size:'normal' },
  { id:10, title:'Banff Turquoise Lake',         location:'Banff, Canada',          cat:'Americas',  img:'https://images.unsplash.com/photo-1503614472-8c93d56e92ce?auto=format&fit=crop&w=1200&q=85', size:'wide' },
  { id:11, title:'African Elephant Sunset',      location:'Amboseli, Kenya',        cat:'Africa',    img:'https://images.unsplash.com/photo-1547471080-7cc2caa01a7e?auto=format&fit=crop&w=1200&q=85', size:'normal' },
  { id:12, title:'Glacial Ice Trek',             location:'El Calafate, Argentina', cat:'Adventure', img:'https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=1200&q=85', size:'tall' },
  { id:13, title:'Swiss Alpine Village',         location:'Lauterbrunnen, Swiss',   cat:'Europe',    img:'https://images.unsplash.com/photo-1530122037265-a5f1f91d3b99?auto=format&fit=crop&w=1200&q=85', size:'normal' },
  { id:14, title:'Tokyo Neon Nights',            location:'Shinjuku, Tokyo',        cat:'Asia',      img:'https://images.unsplash.com/photo-1492571350019-22de08371fd3?auto=format&fit=crop&w=1200&q=85', size:'wide' },
  { id:15, title:'Sahara Dune Sunrise',          location:'Merzouga, Morocco',      cat:'Africa',    img:'https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1200&q=85', size:'normal' },
  { id:16, title:'Norwegian Fjord Silence',      location:'Geirangerfjord, Norway', cat:'Arctic',    img:'https://images.unsplash.com/photo-1509316975850-ff9c5deb0cd9?auto=format&fit=crop&w=1200&q=85', size:'tall' },
  { id:17, title:'Santorini Infinity Pool',      location:'Oia, Santorini',         cat:'Europe',    img:'https://images.unsplash.com/photo-1555993539-1732b0258235?auto=format&fit=crop&w=1200&q=85', size:'normal' },
  { id:18, title:'Amazon Rainforest Canopy',     location:'Manaus, Brazil',         cat:'Americas',  img:'https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&fit=crop&w=1200&q=85', size:'wide' },
  { id:19, title:'Angkor Wat Sunrise Mist',      location:'Siem Reap, Cambodia',    cat:'Asia',      img:'https://images.unsplash.com/photo-1569525927-5e0ad3dbf454?auto=format&fit=crop&w=1200&q=85', size:'normal' },
  { id:20, title:'Husky Sled Arctic Trail',      location:'Lapland, Finland',       cat:'Arctic',    img:'https://images.unsplash.com/photo-1455541504462-57ebb2a9cec1?auto=format&fit=crop&w=1200&q=85', size:'tall' },
  { id:21, title:'Positano Pastel Harbor',       location:'Positano, Italy',        cat:'Europe',    img:'https://images.unsplash.com/photo-1516483638261-f4dbaf036963?auto=format&fit=crop&w=1200&q=85', size:'normal' },
  { id:22, title:'Mount Fuji Cherry Blossom',    location:'Fujiyoshida, Japan',     cat:'Asia',      img:'https://images.unsplash.com/photo-1480796927426-f609979314bd?auto=format&fit=crop&w=1200&q=85', size:'wide' },
  { id:23, title:'Okavango Delta Boat',          location:'Botswana, Africa',       cat:'Africa',    img:'https://images.unsplash.com/photo-1547471080-7cc2caa01a7e?auto=format&fit=crop&w=1200&q=85', size:'normal' },
  { id:24, title:'Grand Canyon Sunrise Vista',   location:'Arizona, USA',           cat:'Americas',  img:'https://images.unsplash.com/photo-1474044159687-1ee9f3a51722?auto=format&fit=crop&w=1200&q=85', size:'tall' },
];

// ── State ──────────────────────────────────────────────────────
let currentCat = 'All';
let currentSearch = '';
const INITIAL_COUNT = 12;
let shownCount = INITIAL_COUNT;
let currentLBIndex = 0;
let filteredItems = [];

// ── Filter logic ───────────────────────────────────────────────
function getFiltered() {
  return galleryItems.filter(item => {
    const catMatch = currentCat === 'All' || item.cat === currentCat;
    const searchMatch = !currentSearch ||
      item.title.toLowerCase().includes(currentSearch) ||
      item.location.toLowerCase().includes(currentSearch) ||
      item.cat.toLowerCase().includes(currentSearch);
    return catMatch && searchMatch;
  });
}

function renderGallery() {
  filteredItems = getFiltered();
  const grid = document.getElementById('gallery-grid');
  const empty = document.getElementById('gallery-empty');
  const loadWrap = document.getElementById('load-more-wrap');
  const loadCount = document.getElementById('load-more-count');

  grid.innerHTML = '';

  if (filteredItems.length === 0) {
    empty.classList.remove('hidden');
    loadWrap.classList.add('hidden');
    return;
  }

  empty.classList.add('hidden');
  const visible = filteredItems.slice(0, shownCount);

  visible.forEach((item, idx) => {
    const card = document.createElement('div');
    card.className = `gallery-card gallery-card--${item.size}`;
    card.setAttribute('data-index', idx);
    card.setAttribute('data-aos', 'fade-up');
    card.setAttribute('data-aos-delay', Math.min(idx * 40, 400));
    card.innerHTML = `
      <img src="${item.img}" alt="${item.title}" loading="lazy">
      <div class="gallery-card-overlay">
        <div class="gallery-card-zoom"><i class="fa-solid fa-magnifying-glass-plus"></i></div>
        <div class="gallery-card-body">
          <span class="gallery-card-cat"><i class="fa-solid fa-tag mr-1"></i>${item.cat}</span>
          <strong class="gallery-card-title">${item.title}</strong>
          <span class="gallery-card-loc"><i class="fa-solid fa-location-dot mr-1"></i>${item.location}</span>
        </div>
      </div>
    `;
    card.addEventListener('click', () => openLightbox(idx));
    grid.appendChild(card);
  });

  // Load more
  const remaining = filteredItems.length - shownCount;
  if (remaining > 0) {
    loadWrap.classList.remove('hidden');
    loadCount.textContent = `${remaining} remaining`;
  } else {
    loadWrap.classList.add('hidden');
  }

  // Re-init AOS
  if (window.AOS) AOS.refreshHard();
}

function filterGallery(cat) {
  currentCat = cat;
  shownCount = INITIAL_COUNT;
  document.querySelectorAll('.gallery-filter-btn').forEach(b => {
    b.classList.toggle('is-active', b.dataset.cat === cat);
  });
  renderGallery();
}

// ── Lightbox ───────────────────────────────────────────────────
function openLightbox(idx) {
  currentLBIndex = idx;
  updateLightbox();
  document.getElementById('gallery-lightbox').classList.add('is-open');
  document.body.style.overflow = 'hidden';
}
function closeLightbox() {
  document.getElementById('gallery-lightbox').classList.remove('is-open');
  document.body.style.overflow = '';
}
function updateLightbox() {
  const item = filteredItems[currentLBIndex];
  const img = document.getElementById('lb-image');
  const loader = document.getElementById('lb-loader');
  loader.style.display = 'flex';
  img.style.opacity = '0';
  img.onload = () => { loader.style.display = 'none'; img.style.opacity = '1'; };
  img.src = item.img.replace('w=1200', 'w=1800');
  img.alt = item.title;
  document.getElementById('lb-title').textContent = item.title;
  document.getElementById('lb-location-text').textContent = item.location;
  document.getElementById('lb-category').textContent = item.cat;
  document.getElementById('lb-counter').textContent = `${currentLBIndex + 1} / ${filteredItems.length}`;
}

// ── Init ───────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  renderGallery();

  AOS.init({ once: true, duration: 650, easing: 'ease-out-cubic' });

  // Filter buttons
  document.querySelectorAll('.gallery-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => filterGallery(btn.dataset.cat));
  });

  // Search
  document.getElementById('gallery-search').addEventListener('input', e => {
    currentSearch = e.target.value.toLowerCase().trim();
    shownCount = INITIAL_COUNT;
    renderGallery();
  });

  // Load more
  document.getElementById('load-more-btn').addEventListener('click', () => {
    shownCount += INITIAL_COUNT;
    renderGallery();
  });

  // Lightbox
  document.getElementById('lb-close').addEventListener('click', closeLightbox);
  document.getElementById('lb-backdrop').addEventListener('click', closeLightbox);
  document.getElementById('lb-prev').addEventListener('click', () => {
    currentLBIndex = (currentLBIndex - 1 + filteredItems.length) % filteredItems.length;
    updateLightbox();
  });
  document.getElementById('lb-next').addEventListener('click', () => {
    currentLBIndex = (currentLBIndex + 1) % filteredItems.length;
    updateLightbox();
  });
  document.addEventListener('keydown', e => {
    const lb = document.getElementById('gallery-lightbox');
    if (!lb.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') { currentLBIndex = (currentLBIndex - 1 + filteredItems.length) % filteredItems.length; updateLightbox(); }
    if (e.key === 'ArrowRight') { currentLBIndex = (currentLBIndex + 1) % filteredItems.length; updateLightbox(); }
  });

  // Scroll progress
  const bar = document.getElementById('scroll-progress');
  window.addEventListener('scroll', () => {
    const pct = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
    if (bar) bar.style.width = pct + '%';
  });

  // Back to top
  const btt = document.getElementById('back-to-top');
  window.addEventListener('scroll', () => {
    if (btt) {
      if (window.scrollY > 400) { btt.classList.remove('opacity-0','pointer-events-none','translate-y-4'); }
      else { btt.classList.add('opacity-0','pointer-events-none','translate-y-4'); }
    }
  });
  if (btt) btt.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
});
</script>
</body>
</html>
