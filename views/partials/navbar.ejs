<header id="main-nav" class="sticky top-0 z-40 transition-all duration-300 glass-nav">
  <div class="page-shell nav-shell">
    <a href="/" class="brand-lockup" aria-label="Veron Crest Tours and Travels home">
      <img src="/assets/images/Logo.png" alt="Veron Crest Tours and Travels" class="brand-logo">
    </a>
    <nav class="page-nav">
      <a href="/about" class="<%= activePage === 'about' ? 'is-current' : '' %>">About</a>
      <a href="/destinations" class="<%= activePage === 'destinations' ? 'is-current' : '' %>">Destinations</a>
      <a href="/#styles">Experiences</a>
      <a href="/packages" class="<%= activePage === 'packages' ? 'is-current' : '' %>">Packages</a>
      <a href="/#blog">Journal</a>
      <a href="/contact" class="<%= activePage === 'contact' ? 'is-current' : '' %>">Contact</a>
    </nav>
    <a href="/book" class="page-cta <%= activePage === 'book' ? 'is-current' : '' %>">Plan my trip <i class="fa-solid fa-arrow-right"></i></a>
    <button id="mobile-menu-btn" class="lg:hidden p-2 text-slate-600 hover:text-primary-600" aria-label="Open menu">
      <i class="fa-solid fa-bars text-xl"></i>
    </button>
  </div>
</header>

<div id="mobile-menu-drawer" class="fixed inset-0 z-50 transform translate-x-full transition-transform duration-300 lg:hidden">
  <div class="absolute inset-0 bg-black/30 backdrop-blur-sm" id="mobile-overlay"></div>
  <div class="absolute right-0 top-0 bottom-0 w-80 max-w-[85vw] bg-white shadow-2xl flex flex-col">
    <div class="flex items-center justify-between p-5 border-b border-slate-100">
      <span class="font-serif font-extrabold text-lg text-slate-800">Veron <span class="text-primary-500">Crest</span></span>
      <button id="mobile-menu-close-btn" class="p-2 text-slate-400 hover:text-slate-700" aria-label="Close menu"><i class="fa-solid fa-xmark text-xl"></i></button>
    </div>
    <nav class="flex-1 p-5 space-y-1 text-[15px] font-semibold text-slate-700 overflow-y-auto">
      <a href="/about" class="mobile-nav-link block py-3 px-3 rounded-xl hover:bg-primary-50 hover:text-primary-600 transition">About Veron Crest</a>
      <a href="/destinations" class="mobile-nav-link block py-3 px-3 rounded-xl hover:bg-primary-50 hover:text-primary-600 transition">Destinations</a>
      <a href="/#styles" class="mobile-nav-link block py-3 px-3 rounded-xl hover:bg-primary-50 hover:text-primary-600 transition">Experiences</a>
      <a href="/packages" class="mobile-nav-link block py-3 px-3 rounded-xl hover:bg-primary-50 hover:text-primary-600 transition">Tour Packages</a>
      <a href="/#blog" class="mobile-nav-link block py-3 px-3 rounded-xl hover:bg-primary-50 hover:text-primary-600 transition">Travel Journal</a>
      <a href="/contact" class="mobile-nav-link block py-3 px-3 rounded-xl hover:bg-primary-50 hover:text-primary-600 transition">Contact Us</a>
      <div class="pt-4 border-t border-slate-100 mt-4">
        <label class="block text-xs text-slate-400 mb-1 font-normal" for="mobile-currency-selector">Currency</label>
        <select id="mobile-currency-selector" class="w-full border border-slate-200 rounded-xl py-2 px-3 text-sm focus:outline-none focus:border-primary-400">
          <option value="USD">USD ($)</option>
          <option value="EUR">EUR (€)</option>
          <option value="GBP">GBP (£)</option>
          <option value="AUD">AUD (A$)</option>
          <option value="INR">INR (₹)</option>
          <option value="CAD">CAD (C$)</option>
        </select>
      </div>
    </nav>
    <div class="p-5 border-t border-slate-100">
      <a href="/book" class="mobile-nav-link block w-full py-3 bg-primary-500 hover:bg-primary-600 text-white font-bold text-center rounded-xl text-sm transition">Start Planning</a>
    </div>
  </div>
</div>
